{
  "name": "desktop",
  "version": "1.0.0",
  "description": "Phone Toolkit Desktop App",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:main\"",
    "dev:vite": "vite",
    "start:vite": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:electron": "node ../../scripts/run-electron.cjs .",
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && vite build",
    "preview": "vite preview",
    "package": "electron-builder",
    "package:dev": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "qa:mac:unsigned": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish never",
    "release:mac": "../../scripts/check-macos-production-release.sh && npm run build && electron-builder --mac --publish never",
    "release:win": "npm run build && electron-builder --win --publish never",
    "lint": "eslint src --ext .ts,.tsx --config ../../eslint.config.js",
    "lint:fix": "eslint src --ext .ts,.tsx --config ../../eslint.config.js --fix"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.0.0",
    "electron-updater": "^6.8.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "cross-env": "^10.1.0",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
